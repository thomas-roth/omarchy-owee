{
  "schemaVersion": 1,
  "id": "owee.weather",
  "name": "Omarchy Weather Enhanced Experience (OWEE)",
  "version": "1.4.0",
  "author": "Plapie690",
  "description": "Worldwide weather with honest coverage, hourly rain timelines and configurable notifications",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OWEE",
    "description": "Weather, forecasts and radar",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "schema": [
      {
        "key": "temperatureMode",
        "type": "string",
        "label": "Temperature units: system, C or F (unset preserves existing choice)"
      },
      {
        "key": "formatMode",
        "type": "string",
        "label": "Date and number formats: english or system"
      },
      {
        "key": "autoRefresh",
        "type": "boolean",
        "label": "Automatic weather refresh"
      }
    ]
  },
  "license": "MIT"
}
